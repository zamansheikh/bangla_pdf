# Development harnesses and audit evidence: useful in the repo, not in the
# published archive.
tool/
docs/baseline/
build/
.dart_tool/
bangla_pdf.iml

# Font fixtures are large and only needed to re-run the verification suite.
test/fixtures/

# Audit and verification write-ups live in the repository, not the archive.
# (Pub prefers a singular "doc/" directory; ours is "docs/" per the project brief.)
docs/

# Stray PDFs from a manual test run must never reach the archive.
*.pdf

# Font files dropped at the root for local inspection are not part of the
# package; the bundled fonts are embedded as Dart source under lib/.
/*.ttf
/*.otf
